# Picom Configuration - Minimal
# X is different on AMD from INTEL it seems

backend = "glx";
vsync = false;
daemon = false;
log-level = "warn";
shadow = false;
fading = false;
inactive-opacity = 1.0;
frame-opacity = 1.0;
opacity-rule = [];
corner-radius = 0;
blur-background = false;
mark-wmwin-focused = true;
mark-ovredir-focused = true;
use-ewmh-active-win = true;
detect-rounded-corners = true;
detect-client-opacity = true;
use-damage = true;

# Window type settings - minimal
wintypes:
{
  tooltip = { fade = false; shadow = false; opacity = 1.0; focus = true; full-shadow = false; };
  dock = { shadow = false; clip-shadow-above = true; };
  dnd = { shadow = false; };
  popup_menu = { opacity = 1.0; shadow = false; };
  dropdown_menu = { opacity = 1.0; shadow = false; };
};

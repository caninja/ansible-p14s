# ==============================================================================
# TLP - BALANCED MODE
# ==============================================================================
# Good balance between battery life and performance
# Optimized for Lenovo P14s Gen6 AMD (Ryzen AI 7 PRO 350)

TLP_ENABLE=1

# CPU - Balanced (performant)
CPU_DRIVER_OPMODE_ON_AC=passive
CPU_DRIVER_OPMODE_ON_BAT=passive

CPU_SCALING_GOVERNOR_ON_AC=schedutil
CPU_SCALING_GOVERNOR_ON_BAT=schedutil

# Allow full frequency range on AC, limit to 4.0 GHz on battery
CPU_SCALING_MIN_FREQ_ON_AC=623377
CPU_SCALING_MAX_FREQ_ON_AC=5090910
CPU_SCALING_MIN_FREQ_ON_BAT=623377
CPU_SCALING_MAX_FREQ_ON_BAT=4000000

CPU_BOOST_ON_AC=1
CPU_BOOST_ON_BAT=1

CPU_ENERGY_PERF_POLICY_ON_AC=balance_performance
CPU_ENERGY_PERF_POLICY_ON_BAT=balance_power

# Platform profile
PLATFORM_PROFILE_ON_AC=balanced
PLATFORM_PROFILE_ON_BAT=balanced

# Disk - Moderate
DISK_IDLE_SECS_ON_AC=0
DISK_IDLE_SECS_ON_BAT=2
MAX_LOST_WORK_SECS_ON_AC=15
MAX_LOST_WORK_SECS_ON_BAT=60

SATA_LINKPWR_ON_AC="med_power_with_dipm max_performance"
SATA_LINKPWR_ON_BAT="med_power_with_dipm"

# NVMe - Balanced
AHCI_RUNTIME_PM_ON_AC=on
AHCI_RUNTIME_PM_ON_BAT=auto

# Audio - No power saving (avoids pops/clicks)
SOUND_POWER_SAVE_ON_AC=0
SOUND_POWER_SAVE_ON_BAT=0
SOUND_POWER_SAVE_CONTROLLER=N

# AMD GPU - Balanced
AMDGPU_ABM_LEVEL_ON_AC=0
AMDGPU_ABM_LEVEL_ON_BAT=2
RADEON_DPM_PERF_LEVEL_ON_AC=auto
RADEON_DPM_PERF_LEVEL_ON_BAT=auto
RADEON_DPM_STATE_ON_AC=performance
RADEON_DPM_STATE_ON_BAT=balanced

# PCIe & Runtime PM - Balanced
PCIE_ASPM_ON_AC=default
PCIE_ASPM_ON_BAT=powersave
RUNTIME_PM_ON_AC=on
RUNTIME_PM_ON_BAT=auto

# USB - Moderate autosuspend
USB_AUTOSUSPEND=1
USB_EXCLUDE_BTUSB=1

# Wireless - Power saving OFF to avoid bugs
WIFI_PWR_ON_AC=off
WIFI_PWR_ON_BAT=off

# Keep bluetooth/wifi available
DEVICES_TO_DISABLE_ON_BAT_NOT_IN_USE="nfc"
DEVICES_TO_ENABLE_ON_AC="bluetooth wifi"

# Battery thresholds for Lenovo (preserves battery health)
START_CHARGE_THRESH_BAT0=75
STOP_CHARGE_THRESH_BAT0=80
RESTORE_THRESHOLDS_ON_BAT=1

# Kernel
NMI_WATCHDOG=0

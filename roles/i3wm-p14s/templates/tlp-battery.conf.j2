# ==============================================================================
# TLP - BATTERY SAVER MODE
# ==============================================================================
# Maximum battery life - usable performance with power savings
# Optimized for Lenovo P14s Gen6 AMD (Ryzen AI 7 PRO 350)

TLP_ENABLE=1

# CPU - Power Saving but usable
CPU_DRIVER_OPMODE_ON_AC=passive
CPU_DRIVER_OPMODE_ON_BAT=passive

CPU_SCALING_GOVERNOR_ON_AC=schedutil
CPU_SCALING_GOVERNOR_ON_BAT=schedutil

# Limit CPU frequency for battery savings (2 GHz min usable on BAT)
CPU_SCALING_MIN_FREQ_ON_AC=623377
CPU_SCALING_MAX_FREQ_ON_AC=3500000
CPU_SCALING_MIN_FREQ_ON_BAT=623377
CPU_SCALING_MAX_FREQ_ON_BAT=2000000

CPU_BOOST_ON_AC=0
CPU_BOOST_ON_BAT=0

CPU_ENERGY_PERF_POLICY_ON_AC=balance_power
CPU_ENERGY_PERF_POLICY_ON_BAT=power

# Platform profile
PLATFORM_PROFILE_ON_AC=low-power
PLATFORM_PROFILE_ON_BAT=low-power

# Disk - Aggressive power saving
DISK_IDLE_SECS_ON_AC=1
DISK_IDLE_SECS_ON_BAT=2
MAX_LOST_WORK_SECS_ON_AC=30
MAX_LOST_WORK_SECS_ON_BAT=90

SATA_LINKPWR_ON_AC="med_power_with_dipm"
SATA_LINKPWR_ON_BAT="med_power_with_dipm min_power"

# NVMe - Aggressive power saving
AHCI_RUNTIME_PM_ON_AC=auto
AHCI_RUNTIME_PM_ON_BAT=auto
AHCI_RUNTIME_PM_TIMEOUT=10

# Audio - No power saving (avoids pops/clicks)
SOUND_POWER_SAVE_ON_AC=0
SOUND_POWER_SAVE_ON_BAT=0
SOUND_POWER_SAVE_CONTROLLER=N

# AMD GPU - Power saving
AMDGPU_ABM_LEVEL_ON_AC=2
AMDGPU_ABM_LEVEL_ON_BAT=3
RADEON_DPM_PERF_LEVEL_ON_AC=low
RADEON_DPM_PERF_LEVEL_ON_BAT=low
RADEON_DPM_STATE_ON_AC=battery
RADEON_DPM_STATE_ON_BAT=battery

# PCIe & Runtime PM - Maximum power saving
PCIE_ASPM_ON_AC=powersave
PCIE_ASPM_ON_BAT=powersupersave
RUNTIME_PM_ON_AC=auto
RUNTIME_PM_ON_BAT=auto

# USB - Autosuspend enabled
USB_AUTOSUSPEND=1
USB_EXCLUDE_BTUSB=1

# Wireless - Power saving OFF to avoid bugs
WIFI_PWR_ON_AC=off
WIFI_PWR_ON_BAT=off

# Keep bluetooth/wifi available, disable NFC
DEVICES_TO_DISABLE_ON_BAT_NOT_IN_USE="nfc"
DEVICES_TO_DISABLE_ON_STARTUP="nfc"

# Battery thresholds for Lenovo (preserves battery health)
START_CHARGE_THRESH_BAT0=75
STOP_CHARGE_THRESH_BAT0=80
RESTORE_THRESHOLDS_ON_BAT=1

# Kernel
NMI_WATCHDOG=0
